  {
    "KEY": "greeting_supplimentary.negative.tales",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "Tales of your misdeeds are told from Ireland to Cathay.",
    "RUS": "О ваших злодеяниях рассказывают от Ирландии до Катая.",
    "POL": "Opowieści o twoich występkach przekazywane są od Irlandii po Chiny.",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.greek",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "Your low character is the subject of Greek plays.",
    "RUS": "Ваш дурной нрав достоин греческих комедий.",
    "POL": "Twoja tragiczna postać jest tematem greckich sztuk!",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.insult.1",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "May your humors rot in your living body.",
    "RUS": "Пусть гуморы гниют в вашем теле.",
    "POL": "Niech twoje soki wysuszą cię na wiór!",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.insult.2",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "May your years be short and miserable.",
    "RUS": "Да будет жизнь ваша коротка и жалка.",
    "POL": "Niech twoje życie będzie krótkie i nieszczęśliwe!",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.insult.3",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "May wisdom ever elude you.",
    "RUS": "Пусть мудрость избегает вас.",
    "POL": "Niech mądrość zawsze pozostanie Wam obca!",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.insult_muslim.1",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "Damn your seventh grandfather.",
    "RUS": "Проклятье на вас до седьмого колена.",
    "POL": "Bądź przeklęty do siódmego pokolenia!",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.insult_muslim.2",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "May you be sewn up alive in the belly of a dead camel.",
    "RUS": "Чтоб вас живьем зашили в брюхе мертвого верблюда.",
    "POL": "Obyś został[Select_CString( second.IsFemale, 'a', '' )] zaszyt[Select_CString( second.IsFemale, 'a', 'y' )] żywcem w brzuchu martwego wielbłąda!",
    "BEL": ""
  },
  {
    "KEY": "greeting_supplimentary.negative.insult_muslim.3",
    "FILE_PATH": "localization/belarusian/custom_localization/greeting_custom_loc_l_belarusian.json",
    "ENG": "May Allah destroy your house.",
    "RUS": "Да уничтожит Аллах ваш дом.",
    "POL": "Niech Allah zniszczy twój ród!",
    "BEL": ""
  },
  {
