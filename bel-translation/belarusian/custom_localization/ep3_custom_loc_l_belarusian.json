  {
    "KEY": "BLUE_VENETOI_GLOSS",
    "FILE_PATH": "localization/belarusian/custom_localization/ep3_custom_loc_l_belarusian.json",
    "ENG": "The #bold Venetoi#!, a period name for ",
    "RUS": "#bold Венеты#! были сторонниками «синих» — одной из наиболее престижных команд константинопольского ипподрома. Они считались партией высших слоев общества. Прославленный возница Порфирий представлял команду «синих», хотя в ходе восстания «Ника» он ненадолго примкнул к «зеленым».",
    "POL": "Mianem #bold Venetoi#! współcześni określali frakcję Niebieskich, jedną z cieszących się największym prestiżem drużyn występujących na hipodromie w Konstantynopolu. Stronnictwo to łączono z klasami wyższymi. Najsłynniejszy woźnica, Porfiriusz, był szanowanym członkiem Niebieskich, choć na krótko zmienił barwy i dołączył do Zielonych podczas powstania Nika.",
    "BEL": ""
  },
  {
    "KEY": "GREEN_PRASINOI_GLOSS",
    "FILE_PATH": "localization/belarusian/custom_localization/ep3_custom_loc_l_belarusian.json",
    "ENG": "The #bold Prasinoi#!, a period name for ",
    "RUS": "#bold Прасины#! были сторонниками «зеленых», которые считались народной командой. В VI веке «зеленые» перебили около трех тысяч «синих» в константинопольском амфитеатре.",
    "POL": "Mianem #bold Prasinoi#! współcześni określali frakcję Zielonych, uważaną za stronnictwo popularne wśród prostego ludu. W VI wieku Zieloni wyrżnęli około 3000 Niebieskich w amfiteatrze Konstantynopola.",
    "BEL": ""
  },
  {
    "KEY": "WHITE_LEUKOI_GLOSS",
    "FILE_PATH": "localization/belarusian/custom_localization/ep3_custom_loc_l_belarusian.json",
    "ENG": "The #bold Leukoi#!, a period name for ",
    "RUS": "#bold Левки#! были сторонниками «белых». Хотя эта команда всегда находилась в тени «синих» и «зеленых», она сохраняла определенное влияние. К нашему времени «белых» окончательно поглотили «синие».",
    "POL": "Mianem #bold Leukoi#! współcześni określali frakcję Białych, która nie zapisała się w historii tak wyraźnie, jak Niebiescy czy Zieloni, lecz z pewnością nie była nieistotna. W przedstawionych tu czasach Biali byli już włączeni w szeregi Niebieskich.",
    "BEL": ""
  },
  {
    "KEY": "RED_RHOUSIOI_GLOSS",
    "FILE_PATH": "localization/belarusian/custom_localization/ep3_custom_loc_l_belarusian.json",
    "ENG": "The #bold Rhousioi#!, a period name for ",
    "RUS": "#bold Русии#! были сторонниками «красных». Хотя эта команда всегда находилась в тени «синих» и «зеленых», она сохраняла определенное влияние. К нашему времени «красных» окончательно поглотили «зеленые».",
    "POL": "Mianem #bold Rousioi#! współcześni określali frakcję Czerwonych, która nie zapisała się w historii tak wyraźnie, jak Niebiescy czy Zieloni, lecz z pewnością nie była nieistotna. W przedstawionych tu czasach Czerwoni byli już włączeni w szeregi Zielonych.",
    "BEL": ""
  },
