    "BEL": ""
  },
  {
    "KEY": "peregrine_falcon_desc",
    "FILE_PATH": "localization/belarusian/modifiers/court_event_modifiers_george_l_belarusian.json",
    "ENG": "This character owns a falcon or hawk, a prestigious bird used for hunting and showing off.\\n#weak Improves $hunt_type_falconry$ [hunt_success_chance|E]#!",
    "RUS": "У этого персонажа есть ручной сокол или ястреб — престижная хищная птица для охоты и демонстрации.\\n#weak Увеличивает [hunt_success_chance|El] соколиной охоты#!",
    "POL": "Ta postać posiada sokoła lub jastrzębia, prestiżowego ptaka używanego do polowań i afiszowania się.\\n#weak Zwiększa [Concept( 'hunt_success_chance', 'szansę powodzenia polowania' )|E] sokolniczego#!",
    "BEL": ""
  },
