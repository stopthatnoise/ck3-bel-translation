  {
    "KEY": "master_of_horse_cavalry_bonus_desc",
    "FILE_PATH": "localization/belarusian/modifiers/court_event_modifiers_george_l_belarusian.json",
    "ENG": "This character's [GetCourtPositionType('master_of_horse_court_position').GetName()] has reason to put extra effort into the arduous task of instructing other people to take good care of the horses.",
    "RUS": "[GetCourtPositionType('master_of_horse_court_position').GetName()] этого персонажа имеет весомую причину прикладывать больше усилий к обучению других правильному уходу за лошадьми.",
    "POL": "[GetCourtPositionType('master_of_horse_court_position').GetName()] tej postaci ma powód, by wkładać dodatkowy wysiłek w żmudne zadanie instruowania innych ludzi, by dobrze opiekowali się końmi.",
    "BEL": ""
  },
  {
    "KEY": "master_of_hunt_activity_bonus",
    "FILE_PATH": "localization/belarusian/modifiers/court_event_modifiers_george_l_belarusian.json",
