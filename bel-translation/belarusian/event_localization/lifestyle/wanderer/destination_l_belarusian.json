    "ENG": "[travel_leader_character.GetSheHe|U] does not interest me.",
    "RUS": "[Select_CString(travel_leader_character.IsFemale, 'Она', 'Он' )] меня не интересует.",
    "POL": "[travel_leader_character.GetSheHe|U] mnie nie interesuje.",
    "BEL": ""
