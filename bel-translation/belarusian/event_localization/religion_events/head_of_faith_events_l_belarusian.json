  {
    "KEY": "head_of_faith.0001.desc",
    "FILE_PATH": "localization/belarusian/event_localization/religion_events/head_of_faith_events_l_belarusian.json",
    "ENG": "We [ROOT.Char.GetFaith.GetAdherentName] have chosen to follow the path of the heirs of Abu Bakr, $head_of_faith.0000.desc$",
    "RUS": "Мы, [ROOT.Char.GetFaith.GetAdherentNamePlural|l], решили следовать по пути наследников Абу Бакра, $head_of_faith.0000.desc$",
    "POL": "My [ROOT.Char.GetFaith.GetAdherentName] wybraliśmy ścieżkę następców Abu Bakra, $head_of_faith.0000.desc$",
    "BEL": ""
  },
  {
    "KEY": "head_of_faith.0001.a",
