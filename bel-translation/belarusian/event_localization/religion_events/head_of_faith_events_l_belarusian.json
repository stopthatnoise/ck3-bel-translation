  {
    "KEY": "head_of_faith.0032.t",
    "FILE_PATH": "localization/belarusian/event_localization/religion_events/head_of_faith_events_l_belarusian.json",
    "ENG": "Pledge of Faith",
    "RUS": "Религиозное прошение",
    "POL": "Przyrzeczenie wiary",
    "BEL": ""
  },
  {
    "KEY": "head_of_faith.0032.desc",
    "FILE_PATH": "localization/belarusian/event_localization/religion_events/head_of_faith_events_l_belarusian.json",
    "ENG": "To the [pledge_target.GetTitledFirstNameNoTooltip], we, the [pledgeing_individual.GetFaith.GetAdherentNamePlural], wish to pledge loyalty to you and have you as our [head_of_faith|E].\\n\\nWill you please take us under your guidance?",
    "RUS": "[pledge_target.GetTitledFirstNameNoTooltip], мы, [pledgeing_individual.GetFaith.GetAdherentNamePlural|l], желаем присягнуть вам на верность и сделать [Concept( 'head_of_faith', 'главой конфессии' )|E].\\n\\nВозьметесь ли вы наставлять нас?",
    "POL": "[pledge_target.GetTitledFirstNameNoTooltip], my, [pledgeing_individual.GetFaith.GetAdherentNamePlural|l], pragniemy przyrzec ci wierność i mieć cię za naszą [Concept( 'head_of_faith', 'głowę wiary' )|E].\\n\\nCzy zechcesz nam przewodzić?",
    "BEL": ""
  },
  {
