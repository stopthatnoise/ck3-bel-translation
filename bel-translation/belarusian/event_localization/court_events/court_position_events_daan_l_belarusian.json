  {
    "KEY": "court_position_management_event.0001.c",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "Perhaps we can find some suitable candidates elsewhere...",
    "RUS": "Возможно, мы найдем подходящую кандидатуру за пределами страны…",
    "POL": "Być może znajdziemy kilku odpowiednich kandydatów gdzie indziej…",
    "BEL": ""
  },
