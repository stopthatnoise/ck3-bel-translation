[
  {
    "KEY": "court_position_management_event.0001.t",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "Vacated: [court_position_type.GetNameNoTooltip()]",
    "RUS": "Освободилась должность: [court_position_type.GetNameNoTooltip()]",
    "POL": "Wolny urząd: [court_position_type.GetNameNoTooltip()|l]",
    "BEL": ""
  },
  {
    "KEY": "court_position_management_event.0001.desc",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "My [court_position_type.GetName()] court position was vacated by [employee.GetFullName].",
    "RUS": "[employee.GetFullName] [Select_CString(employee.IsFemale,'оставила', 'оставил')] придворную должность «[court_position_type.GetName()]».",
    "POL": "Osoba znana jako [employee.GetFullName] zwolniła urząd dworski, którym jest [court_position_type.GetName()|l]",
    "BEL": ""
  },
  {
    "KEY": "court_position_management_event.0001.desc.dead",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "[employee.GetSheHe|U] [employee.GetDeathReason].",
    "RUS": "[employee.GetSheHe|U] [employee.GetDeathReason].",
    "POL": "Osoba ta [employee.GetDeathReason].",
    "BEL": ""
  },
  {
    "KEY": "court_position_management_event.0001.desc.one_candidate",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "\\n\\nMy advisors have found only one candidate that could fill the position, [candidate_1.GetFullName].",
    "RUS": "\\n\\nСоветники видят только одного достойного кандидата [Select_CString(employee.IsFemale,'ей', 'ему')] на замену — это [candidate_1.GetFullName].",
    "POL": "\\n\\nMoi doradcy znaleźli tylko jednego kandydata, który mógłby objąć ten urząd, i jest nim [candidate_1.GetFullName].",
    "BEL": ""
  },
  {
    "KEY": "court_position_management_event.0001.desc.two_candidates",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "\\n\\nMy advisors have suggested some candidates from my realm that could fill the position, namely [candidate_1.GetFullName] and [candidate_2.GetFullName].",
    "RUS": "\\n\\nСоветники предлагают несколько подходящих кандидатов [Select_CString(employee.IsFemale,'ей', 'ему')] на замену — это [candidate_1.GetFullName] и [candidate_2.GetFullName].",
    "POL": "\\n\\nMoi doradcy zasugerowali kilkoro kandydatów z mojego otoczenia, którzy mogliby objąć ten urząd. To [candidate_1.GetFullName] oraz [candidate_2.GetFullName].",
    "BEL": ""
  },
  {
    "KEY": "court_position_management_event.0001.desc.no_candidates",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "\\n\\nMy advisors have found no candidates to replace [employee.GetHerHim] from my realm.",
    "RUS": "\\n\\nСоветники не знают, кто мог бы [Select_CString(employee.IsFemale,'ее', 'его')] заменить.",
    "POL": "\\n\\nMoi doradcy nie znaleźli w moim państwie nikogo, kto mógłby [employee.Custom('PL_go_ja')] zastąpić.",
    "BEL": ""
  },
  {
    "KEY": "court_position_management_event.0001.a",
    "FILE_PATH": "localization/belarusian/event_localization/court_events/court_position_events_daan_l_belarusian.json",
    "ENG": "[candidate_1.GetFirstNameNoTooltip] is right for the job!",
    "RUS": "[candidate_1.GetFirstNameNoTooltip] подойдет!",
