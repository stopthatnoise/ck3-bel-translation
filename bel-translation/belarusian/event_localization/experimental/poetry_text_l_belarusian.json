[
  {
    "KEY": "first_line_text_set_1_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "I am a gentle, delicate flower",
    "RUS": "Я твой нежный цветок благородный.",
    "POL": "Jestem niczym te delikatne kwiatów łany,",
    "BEL": ""
  },
  {
    "KEY": "first_line_text_set_1_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "I wish you'd invite me to your bower",
    "RUS": "Пригласи ты меня отобедать!",
    "POL": "Chcę, byś zaprosiła mnie do swojej altany,",
    "BEL": ""
  },
  {
    "KEY": "first_line_text_set_2_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "You are my guiding star in this",
    "RUS": "Для меня ты маяк путеводный.",
    "POL": "Gwiazdą przewodnią jesteś, tylko cenić Ciebie,",
    "BEL": ""
  },
  {
    "KEY": "first_line_text_set_2_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "I am pretty sure I am not Swiss",
    "RUS": "(Ты же знаешь, что я не из шведов.)",
    "POL": "Szwajcarem nie jestem, dobrze rozumiem siebie,",
    "BEL": ""
  },
  {
    "KEY": "second_line_text_set_1_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "You just make me think of a tower",
    "RUS": "Вид твой с башней сравню крепостною.",
    "POL": "Sprawiasz, że w myślach mam bastion murowany,",
    "BEL": ""
  },
  {
    "KEY": "second_line_text_set_1_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "And I've got so much feudal power",
    "RUS": "Власти много во мне феодальной.",
    "POL": "A władzy mam tyle, co feudalne pany,",
    "BEL": ""
  },
  {
    "KEY": "second_line_text_set_2_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Indeed, it is the cause of all my bliss",
    "RUS": "Он блаженства внутри сердце ноет.",
    "POL": "Szczęścia tego żadna osoba nie pogrzebie,",
    "BEL": ""
  },
  {
    "KEY": "second_line_text_set_2_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Everything comes undone in a gentle kiss",
    "RUS": "Поцелуй твой блаженство подарит.",
    "POL": "Pocałunek lekki, czuję się jak w niebie,",
    "BEL": ""
  },
  {
    "KEY": "third_line_text_set_1_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Maybe I should spend more time thinking",
    "RUS": "Мне б от мыслей избавиться тяжких,",
    "POL": "Może wart spędzić więcej czasu na myśleniu,",
    "BEL": ""
  },
  {
    "KEY": "third_line_text_set_1_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Perhaps I could do something about this stinking",
    "RUS": "Что-то сделать с амбре этим вечным.",
    "POL": "Może wart bardziej przyjrzeć się temu trąceniu,",
    "BEL": ""
  },
  {
    "KEY": "third_line_text_set_2_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Along the path of flight of a little bird",
    "RUS": "Пролететь бы, как малая пташка,",
    "POL": "Wzdłuż drogi ptaszka, w odpowiedzi dążeniu,",
    "BEL": ""
  },
  {
    "KEY": "third_line_text_set_2_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Somewhere in between goat's cheese and curd",
    "RUS": "Между луком и сыром овечьим.",
    "POL": "Między kozim serem a twarogiem istnieniu,",
    "BEL": ""
  },
  {
    "KEY": "fourth_line_text_set_1_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "But I am in love with the feeling of sinking",
    "RUS": "Я тонуть хочу снова и снова...",
    "POL": "Moja miłość ulega tonięcia wrażeniu.",
    "BEL": ""
  },
  {
    "KEY": "fourth_line_text_set_1_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Just kidding, let's do more drinking",
    "RUS": "Вот хоть в кружке. Совсем я пьянею.",
    "POL": "Żartuję, oddajmy się wszyscy upojeniu.",
    "BEL": ""
  },
  {
    "KEY": "fourth_line_text_set_2_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "It is only a single word",
    "RUS": "Одного бы хватило мне слова.",
    "POL": "To jedynie słowo, nie ulega zdwojeniu.",
    "BEL": ""
  },
  {
    "KEY": "fourth_line_text_set_2_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "I'm sorry for getting absurd",
    "RUS": "Ты прости, что несу ахинею.",
    "POL": "Przepraszam, moje usta uległy bredzeniu.",
    "BEL": ""
  },
  {
    "KEY": "poetry_line_break",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "\\n",
    "RUS": "\\n",
    "POL": "\\n",
    "BEL": ""
  },
  {
    "KEY": "poetry.0002.t",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "A Poem!",
    "RUS": "Поэма!",
    "POL": "Poemat!",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_1_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " King Marsilies he lay at Sarraguce,",
    "RUS": " Однажды в зной Марсилий Сарагосский",
    "POL": " Król Marsyl jest w Saragossie,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_1_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Blancandrins was a pagan very wise,",
    "RUS": " Блистал меж мавров Бланкандрен умом.",
    "POL": " Ten ci Blankandryn najmędrszy był śród pogan,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_1_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Charles the King, our Lord and Sovereign,",
    "RUS": " Король наш Карл, великий император,",
    "POL": " Król Karol, cesarz nasz Wielki,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_1_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Merry and bold is now that Emperor,",
    "RUS": " Необычайно радостен и горд:",
    "POL": " Cesarz weseli się, rad jest z siebie,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_2_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Went he his way into an orchard cool;",
    "RUS": "Пошел искать прохлады в сад плодовый.",
    "POL": " Zanurza się w chłodnego sadu cieniu;",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_2_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " In vassalage he was a gallant knight,",
    "RUS": "На поле битвы он боец лихой:",
    "POL": " Rycerz to i wasal, a odwaga jego niesłychana,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_2_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Full seven years hath sojourned in Spain,",
    "RUS": "Провоевал семь лет в стране испанской.",
    "POL": " W Hiszpani, szybko licząc, lat spędził całych siedem,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_2_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Cordres he holds, the walls are tumbled down,",
    "RUS": "Взял Кордову он штурмом, башни снес",
    "POL": " Kordowę zdobył, mury wszystek leżą,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_3_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " There on a throne he sate, of marble blue,",
    "RUS": " И там прилег на мраморное ложе.",
    "POL": " Kładzie się na ganku z błękitnego marmuru,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_3_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " First in prowess, he stood his lord beside.",
    "RUS": " Советом рад сеньеру был помочь,",
    "POL": " Rozumem dobry rajca swego pana.",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_3_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Conquered the land, and won the western main,",
    "RUS": " Весь этот горный край до моря занял,",
    "POL": " Aż po samo morze zdobył tę pyszną ziemię,",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_3_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " His catapults have battered town and tow'r.",
    "RUS": " Баллистами своими стены смел.",
    "POL": " Zwalił kamienne wieże.",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_4_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Round him his men, full twenty thousand, stood.",
    "RUS": "Вкруг — мавры: тысяч двадцать их и больше.",
    "POL": " Dwadzieścia tysięcy ludu stoi wokół niego.",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_4_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " And thus he spoke: ",
    "RUS": "Он говорит: «Оставьте страх пустой».",
    "POL": " – Nie ma się co lękać! – rzecze bez wahania.",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_4_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Now no fortress against him doth remain,",
    "RUS": "Взяв приступом все города и замки,",
    "POL": " Nie ma już przed nim zamków – nie został choćby jeden.",
    "BEL": ""
  },
  {
    "KEY": "0002.blank_verse_line_4_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": " Silver and gold and many a jeweled gown.",
    "RUS": "Рать оделил добычею большой.",
    "POL": " Bogactwa, szaty strojne – nikt ich już nie odbierze.",
    "BEL": ""
  },
  {
    "KEY": "poetry.0003.t",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Poem About [ROOT.GetCharacter.Custom('theme_announcement')|UD]",
    "RUS": "Поэма: [ROOT.GetCharacter.Custom('theme_announcement')|UD]",
    "POL": "Wiersz o [ROOT.GetCharacter.Custom('theme_announcement')|UD]",
    "BEL": ""
  },
  {
    "KEY": "0003.line_1_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "A land laid waste by vicious [ROOT.GetCharacter.Custom('noun_specific_singular_one')|D]",
    "RUS": "Все разорит [ROOT.GetCharacter.Custom('noun_specific_singular_one')|D]-завоеватель.",
    "POL": "Ziemie spustoszone złośliwością [ROOT.GetCharacter.Custom('noun_specific_singular_one')|D]",
    "BEL": ""
  },
  {
    "KEY": "0003.line_1_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "In a lasting age of [ROOT.GetCharacter.Custom('noun_abstract_plural_one')|D]",
    "RUS": "Царят [ROOT.GetCharacter.Custom('noun_abstract_plural_one')|D] ныне — первый сорт.",
    "POL": "W trwającej epoce [ROOT.GetCharacter.Custom('noun_abstract_plural_one')|D]",
    "BEL": ""
  },
  {
    "KEY": "0003.line_1_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] Charles the King, our Lord and Sovereign,",
    "RUS": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] король наш Карл, великий император,",
    "POL": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] Król Karol, cesarz nasz Wielki,",
    "BEL": ""
  },
  {
    "KEY": "0003.line_1_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Merry and bold is now that Emperor,",
    "RUS": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] необычайно радостен и горд.",
    "POL": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Cesarz weseli się, rad jest z siebie,",
    "BEL": ""
  },
  {
    "KEY": "0003.line_2_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "We all gave in to [ROOT.GetCharacter.Custom('noun_abstract_singular_one')|D] so cruel",
    "RUS": "Мы приняли [ROOT.GetCharacter.Custom('noun_abstract_singular_one')|D] на веру, без опаски.",
    "POL": "Wszyscy okrutności [ROOT.GetCharacter.Custom('noun_abstract_singular_one')|D] swe życie oddaliśmy",
    "BEL": ""
  },
  {
    "KEY": "0003.line_2_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Seeing now with eyes of [ROOT.GetCharacter.Custom('noun_abstract_plural_two')|D]",
    "RUS": "[ROOT.GetCharacter.Custom('noun_abstract_plural_two')|D] решит любой вопрос.",
    "POL": "Widząc teraz oczami [ROOT.GetCharacter.Custom('noun_abstract_plural_two')|D]",
    "BEL": ""
  },
  {
    "KEY": "0003.line_2_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Full seven years hath sojourned in Spain,",
    "RUS": "Провоевал [ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] семь лет в стране испанской.",
    "POL": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] W Hiszpanii, szybko licząc, lat spędził całych siedem,",
    "BEL": ""
  },
  {
    "KEY": "0003.line_2_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Cordres he holds, the walls are tumbled down,",
    "RUS": "Взял Кордову он штурмом, [ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] башни снес.",
    "POL": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Kordowę zdobył, mury wszystek leżą,",
    "BEL": ""
  },
  {
    "KEY": "0003.line_3_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "If your [ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] I fail to reach",
    "RUS": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] твой недостижим, я знаю.",
    "POL": "Jeśli [ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] nie móc mi dosięgnąć",
    "BEL": ""
  },
  {
    "KEY": "0003.line_3_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "After [ROOT.GetCharacter.Custom('two_syllable_number')|D] years of [ROOT.GetCharacter.Custom('noun_abstract_plural_two')|D]",
    "RUS": "[ROOT.GetCharacter.Custom('two_syllable_number')|D]. Вот сколько лет уж длится [ROOT.GetCharacter.Custom('noun_abstract_plural_two')|D]!",
    "POL": "Gdy [ROOT.GetCharacter.Custom('two_syllable_number')|D] lat [ROOT.GetCharacter.Custom('noun_abstract_plural_two')|D] już minęło",
    "BEL": ""
  },
  {
    "KEY": "0003.line_3_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] Conquered the land, and won the western main,",
    "RUS": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] весь этот горный край до моря занял,",
    "POL": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] Aż po samo morze zdobył tę pyszną ziemię,",
    "BEL": ""
  },
  {
    "KEY": "0003.line_3_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] His catapults have battered town and tow'r.",
    "RUS": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] баллистами своими стены смел.",
    "POL": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Zwalił kamienne wieże.",
    "BEL": ""
  },
  {
    "KEY": "0003.line_4_A",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "They may never take my [ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D]",
    "RUS": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] врагу не сдам и сразу выйду в дамки.",
    "POL": "Mogą mi nigdy nie zabrać [ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D]",
    "BEL": ""
  },
  {
    "KEY": "0003.line_4_B",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "Soon the [ROOT.GetCharacter.Custom('noun_specific_plural_two')|D] are all forgotten",
    "RUS": "Забудутся [ROOT.GetCharacter.Custom('noun_specific_plural_two')|D], и это хорошо.",
    "POL": "Istność [ROOT.GetCharacter.Custom('noun_specific_plural_two')|D] wkrótce pójdzie w zapomnienie",
    "BEL": ""
  },
  {
    "KEY": "0003.line_4_C",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] Now no fortress against him doth remain,",
    "RUS": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D], штурмом взяв все города и замки,",
    "POL": "[ROOT.GetCharacter.Custom('noun_specific_singular_two')|D] Nie ma już przed nim zamków – nie został choćby jeden.",
    "BEL": ""
  },
  {
    "KEY": "0003.line_4_D",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/poetry_text_l_belarusian.json",
    "ENG": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Silver and gold and many a jeweled gown.",
    "RUS": "Рать оделит [ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] добычею большой.",
    "POL": "[ROOT.GetCharacter.Custom('noun_abstract_singular_two')|D] Bogactwa, szaty strojne – nikt ich już nie odbierze.",
    "BEL": ""
