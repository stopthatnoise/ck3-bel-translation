  },
  {
    "KEY": "insult_poetry_line_1_a_01",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nYou are more stupid than a [ROOT.GetCharacter.Custom('rhyme_group_a_one')]#!",
    "RUS": "#EMP \\nТы глупее, чем [ROOT.GetCharacter.Custom('rhyme_group_a_one')]#!",
