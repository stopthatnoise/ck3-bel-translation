  {
    "KEY": "insult_poetry_line_1_c_01",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nSomeone who is too low to even [ROOT.Char.Custom('rhyme_group_c_one')]#!",
    "RUS": "#EMP \\nНичтожество, пред тобой знатна и [ROOT.Char.Custom('rhyme_group_c_one')]#!",
    "POL": "#EMP \\nKimś tak niskim, niewartym nawet [ROOT.Char.Custom('rhyme_group_c_one')]#!",
    "BEL": ""
  },
  {
    "KEY": "insult_poetry_line_1_c_02",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nAn outcast, unworthy of even a [ROOT.Char.Custom('rhyme_group_c_one')]#!",
    "RUS": "#EMP \\nИзгой, которому роскошь даже [ROOT.Char.Custom('rhyme_group_c_one')]#!",
    "POL": "#EMP \\nWyrzutkiem, niegodnym nawet [ROOT.Char.Custom('rhyme_group_c_one')]#!",
    "BEL": ""
  },
  {
    "KEY": "insult_poetry_line_2_a_01",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nLike no one even [ROOT.GetCharacter.Custom('rhyme_group_a_two')]#!",
    "RUS": "#EMP \\nВсе отвернутся, [ROOT.GetCharacter.Custom('rhyme_group_a_two')]#!",
    "POL": "#EMP \\nJakby każdy, kto cię zna [ROOT.GetCharacter.Custom('rhyme_group_a_two')]#!",
    "BEL": ""
  },
  {
    "KEY": "insult_poetry_line_2_a_02",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nMore than even God [ROOT.GetCharacter.Custom('rhyme_group_a_two')]#!",
    "RUS": "#EMP \\nСам бог тебе скажет: [ROOT.GetCharacter.Custom('rhyme_group_a_two')]#!",
    "POL": "#EMP \\nNawet Bóg [ROOT.GetCharacter.Custom('rhyme_group_a_two')]#!",
    "BEL": ""
  },
  {
    "KEY": "insult_poetry_line_2_b_01",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nBeing around you is a [ROOT.GetCharacter.Custom('rhyme_group_b_two')]#!",
    "RUS": "#EMP \\nБыть с тобой рядом — это [ROOT.GetCharacter.Custom('rhyme_group_b_two')]#!",
    "POL": "#EMP \\nBycie przy tobie to istna [ROOT.GetCharacter.Custom('rhyme_group_b_two')]#!",
    "BEL": ""
  },
  {
    "KEY": "insult_poetry_line_2_b_02",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nMore than even the Lord's [ROOT.GetCharacter.Custom('rhyme_group_b_two')]#!",
    "RUS": "#EMP \\nСам господь тебе скажет: [ROOT.GetCharacter.Custom('rhyme_group_b_two')]#!",
    "POL": "#EMP \\nNawet bardziej niż boska [ROOT.GetCharacter.Custom('rhyme_group_b_two')]#!",
    "BEL": ""
  },
  {
    "KEY": "insult_poetry_line_2_c_01",
    "FILE_PATH": "localization/belarusian/event_localization/experimental/insult_poetry_text_l_belarusian.json",
    "ENG": "#EMP \\nNot even worthy of being [ROOT.GetCharacter.Custom('rhyme_group_c_two')]#!",
