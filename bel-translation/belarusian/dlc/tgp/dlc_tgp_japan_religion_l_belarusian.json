[
  {
    "KEY": "tenet_pure_land_name",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Righteous Rebirth",
    "RUS": "Перерождение праведников",
    "POL": "Zasłużone odrodzenie",
    "BEL": ""
  },
  {
    "KEY": "tenet_pure_land_desc",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Here in #EMP paścima-kāla#! — the Degenerate Age of Dharma — riches, study, nor high birth offer solace. Only true devotees of the Buddha's precepts may find rebirth in the Pure Land.",
    "RUS": "В #EMP пашчимакале#! — эпохе упадка дхармы — ни богатства, ни знания, ни благородное происхождение уже не приносят утешения. Лишь верные последователи учения Будды смогут возродиться в Чистой земле после смерти.",
    "POL": "#EMP Paścima-kāla#! – schyłek dharmy – to czas, w którym ani bogactwo, ani edukacja, ani nawet błękitna krew nie przynoszą pocieszenia. Tylko prawdziwi wyznawcy nauk Buddy mogą liczyć na odrodzenie w Czystej Krainie.",
    "BEL": ""
  },
  {
    "KEY": "tenet_sohei_name",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Sōhei",
    "RUS": "Сохэй",
    "POL": "Sōhei",
    "BEL": ""
  },
  {
    "KEY": "tenet_no_mind_name",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Mind Without Mind",
    "RUS": "Разум без разума",
    "POL": "Bezmyślny umysł",
    "BEL": ""
  },
  {
    "KEY": "tenet_no_mind_desc",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "The mind that is mindless is the mind that has achieved true mindfulness. A state cultivated by artists, craftsmen and martial artists, where the body responds to all challenges without thought.",
    "RUS": "Разум без разума — это разум, достигший вершин разумности. В государстве, которым управляют люди искусства, мастера ремесел и боевых искусств, ни у кого нет непреодолимых трудностей.",
    "POL": "Umysł pozbawiony myśli to umysł, który osiągnął prawdziwą uważność. Jest to stan, do którego dążą artyści, rzemieślnicy i mistrzowie sztuk walki, bowiem po jego osiągnięciu ciało reaguje na wszelkie wyzwania bez udziału myśli.",
    "BEL": ""
  },
  {
    "KEY": "doctrine_parameter_better_artifacts",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Sponsored [inspirations|E] produce [artifacts|E] of higher quality",
    "RUS": "Проспонсированное [Concept('inspirations', 'вдохновение')|E] позволяет создавать [Concept('artifacts', 'артефакты')|E] более высокого качества",
    "POL": "Sponsorowane [Concept('inspirations', 'inspiracje')|E] pozwalają wytwarzać [artifacts|El] wyższej jakości",
    "BEL": ""
  },
  {
    "KEY": "doctrine_parameter_less_likely_to_become_infirm",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Characters are less likely to gain the [GetTrait('infirm').GetName( GetNullCharacter )] [trait|E]",
    "RUS": "Персонажи с меньшей вероятностью получат [Concept('trait', 'свойство')|E] «[GetTrait('infirm').GetName( GetNullCharacter )]»",
    "POL": "Istnieje mniejsze prawdopodobieństwo zyskania przez postaci [Concept('trait', 'cechy')|E] [GetTrait('infirm').GetName(GetNullCharacter)|l]",
    "BEL": ""
  },
  {
    "KEY": "tenet_mountain_worship_name",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Sacred Mountains",
    "RUS": "Священные горы",
    "POL": "Święte góry",
    "BEL": ""
  },
  {
    "KEY": "tenet_mountain_worship_desc",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "High away from villages and farms, mountains touch the very clouds above. It is there, among the peaks and crags, that the sacred can be truly found.",
    "RUS": "Над деревнями возвышаются величественные горы, чьи вершины достают до самых облаков. Именно там, среди высоких скал, можно соприкоснуться с частицей божественного.",
    "POL": "Z dala od wiosek i farm w chmurach nurzają się górskie szczyty. To właśnie tam, wśród wierzchołków i urwisk, kryje się prawdziwa świętość.",
    "BEL": ""
  },
  {
    "KEY": "doctrine_parameter_piety_from_hills_and_mountains_pilgrimages",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "Characters gain extra [piety|E] from [pilgrimages|E] to [GetTerrain( 'hills' ).GetName], [GetTerrain( 'mountains' ).GetName] and [GetTerrain( 'desert_mountains' ).GetName]",
    "RUS": "Персонажи получают больше [Concept('piety', 'благочестия')|E] за [Concept('pilgrimages', 'паломничества')|E] в регионы с типом местности «[GetTerrain( 'hills' ).GetName]», «[GetTerrain( 'mountains' ).GetName]» и «[GetTerrain( 'desert_mountains' ).GetName]»",
    "POL": "Postacie uzyskują dodatkową [piety|El] za [pilgrimages|El] na terenach, którymi są [GetTerrain( 'hills' ).GetName], [GetTerrain( 'mountains' ).GetName] i [GetTerrain( 'desert_mountains' ).GetName].",
    "BEL": ""
  },
  {
    "KEY": "piety_from_hills_and_mountains_pilgrimages_tt",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_japan_religion_l_belarusian.json",
    "ENG": "From the [GetFaithDoctrine('tenet_mountain_worship').GetBaseName] [core_tenet|E]: [piety_i]#P [THIS.ScriptValue('medium_piety_gain')]#!",
    "RUS": "Благодаря [Concept('core_tenet', 'догмату')|E] «[GetFaithDoctrine('tenet_mountain_worship').GetBaseName]»: [piety_i]#P [THIS.ScriptValue('medium_piety_gain')]#!",
    "POL": "[core_tenet|E] „[GetFaithDoctrine('tenet_mountain_worship').GetBaseName]”: [piety_i] #P [THIS.ScriptValue('medium_piety_gain')]#!",
    "BEL": ""
  },
  {
