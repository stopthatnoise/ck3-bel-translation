  {
    "KEY": "TRANSFER_GOLD_TO_TREASURY_INTERACTION_TOOLTIP",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_treasury_l_belarusian.json",
    "ENG": "#T Supplement Treasury#!\\n[Character.GetPlayerInteractionAcceptEffectDescription('transfer_small_gold_amount_to_treasury_interaction')]#!\\n\\n#i Right-click to transfer [gold_i]#V 50#!\\n#i Ctrl-left-click to transfer [gold_i]#V 500#!",
