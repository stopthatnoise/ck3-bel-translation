  {
    "KEY": "TRANSFER_TREASURY_TO_GOLD_DECISION_TOOLTIP",
    "FILE_PATH": "localization/belarusian/dlc/tgp/dlc_tgp_treasury_l_belarusian.json",
    "ENG": "#T Withdraw Gold#!\\nWithdraw [gold_i][Character.CalcScriptedValue('medium_treasury_value')|0] from your Treasury, with some consequences.\\n[AddLine( Decision.GetCommandDescForPlayer)]\\n#i Click to open [Decision.GetName]#!",
