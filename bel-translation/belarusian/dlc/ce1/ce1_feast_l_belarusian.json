[
  {
    "KEY": "feast_type_legendary",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "Legendary Feast",
    "RUS": "Легендарный пир",
    "POL": "Legendarna uczta",
    "BEL": ""
  },
  {
    "KEY": "feast_type_legendary_desc",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "$EFFECT_LIST_BULLET$ The $feast_phase_toast$ is focused on your [legend|E]\\n$EFFECT_LIST_BULLET$ Events will lead to occasions to gain [opinion|E]\\n$EFFECT_LIST_BULLET$ Certain options will allow for [stress|E] loss\\n\\n#weak A story for the ages.#!",
    "RUS": "$EFFECT_LIST_BULLET$ Тост в честь вашей [Concept( 'legend', 'легенды' )|E]$EFFECT_LIST_BULLET$ События — это возможность составить [Concept( 'opinion', 'мнение' )|E]\\n$EFFECT_LIST_BULLET$ Определенные варианты позволят избавиться от [Concept( 'stress', 'стресса' )|E]\\n\\n#weak История на века.#!",
    "POL": "$EFFECT_LIST_BULLET$ $feast_phase_toast$ dotyczy twojej [Concept('legend', 'legendy')|E]\\n$EFFECT_LIST_BULLET$ Wydarzenia będą prowadzić do sposobności zyskania na [Concept('opinion', 'opinii')|E]\\n$EFFECT_LIST_BULLET$ Niektóre opcje pozwolą ci obniżyć [stress|El]\\n\\n#weak Klasyczna historia.#!",
    "BEL": ""
  },
  {
    "KEY": "legendary_feast_valid_tt",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "You do #bold not#! have an [promoted_legend|E]",
    "RUS": "У вас #bold нет#! [Concept( 'promoted_legend', 'поддерживаемой легенды' )|E]",
    "POL": "#bold Nie#! posiadasz [Concept('promoted_legend', 'promowanej legendy')|E]",
    "BEL": ""
  },
  {
    "KEY": "feast.7204.t",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "A Tale to Tell",
    "RUS": "Есть что рассказать",
    "POL": "Opowieść do opowiedzenia",
    "BEL": ""
  },
  {
    "KEY": "feast.7204.desc",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "The sound of [ROOT.GetCharacter.Custom('GetMusicalInstrumentPlural')] fills the halls of [activity.GetCurrentPhase.GetLocation.GetNameNoTooltip] while the guests sip the last drops of [ROOT.Char.Custom('RegionalAlcoholicDrink')]. Above them, the voice of [bard.GetTitledFirstName] rises harmonically.\\n\\n",
    "RUS": "[ROOT.GetCharacter.Custom('GetMusicalInstrumentPlural')|U] заполняют музыкой залы владения [activity.GetCurrentPhase.GetLocation.GetNameNoTooltip], и [ROOT.Char.Custom('RegionalAlcoholicDrink')] в чашах гостей подходит к концу. [bard.GetTitledFirstName] перекрывает своим голосом все прочие звуки.\\n\\n«Слушайте! Слушайте! Ибо моими устами будет излагаться [ROOT.Char.GetPromotedLegend.GetName]».",
    "POL": "Korytarze w miejscu znanym jako [activity.GetCurrentPhase.GetLocation.GetNameNoTooltip] wypełniają się dźwiękiem, jaki wydają [ROOT.GetCharacter.Custom('GetMusicalInstrumentPlural')], a [ROOT.Char.Custom('RegionalAlcoholicDrink')] już się kończy. Nad gośćmi harmonijnie unosi się głos osoby znanej jako [bard.GetTitledFirstName].\\n\\n– Słuchajcie teraz! Słuchajcie! Opowiem wam legendę o nazwie „[ROOT.Char.GetPromotedLegend.GetName]”.",
    "BEL": ""
  },
  {
    "KEY": "feast.7204.a",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "Everyone will be talking about this!",
    "RUS": "Об этом будут говорить все!",
    "POL": "Wszyscy będą o tym mówić!",
    "BEL": ""
  },
  {
    "KEY": "feast.7204.b",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "Hah! Don't forget that it's #EMP my#! legend!",
    "RUS": "Ха! Не забывайте, это #EMP моя#! легенда!",
    "POL": "Ha! Nie zapominaj, że to #EMP moja#! legenda!",
    "BEL": ""
  },
  {
    "KEY": "feast.7204.c",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "My guests will never forget a performance like this.",
    "RUS": "Такое представление мои гости не забудут.",
    "POL": "Moi goście nigdy nie zapomną tego występu.",
    "BEL": ""
  },
  {
    "KEY": "feast.7204.d",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "Here's to many more!",
    "RUS": "Выпьем, чтобы историй было больше!",
    "POL": "Wypijmy za kolejne takie legendy!",
    "BEL": ""
  },
  {
    "KEY": "feast.7205.t",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "A Tale to Listen",
    "RUS": "Есть что послушать",
    "POL": "Opowieść do wysłuchania",
    "BEL": ""
  },
  {
    "KEY": "feast.7205.desc",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "$feast.7204.desc$\\n\\nNext to [bard.GetHerHim], [host.GetTitledFirstName] smiles proudly.",
    "RUS": "$feast.7204.desc$\\n\\nРядом с [Select_CString(bard.IsFemale, 'ней', 'ним' )] стоит гордо [Select_CString(host.IsFemale, 'улыбающаяся', 'улыбающийся' )] [host.GetTitledFirstName].",
    "POL": "$feast.7204.desc$\\n\\nObok [bard.Custom('PL_niego_niej')] [host.GetTitledFirstName] uśmiecha się dumnie.",
    "BEL": ""
  },
  {
    "KEY": "feast.7205.a",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "What a wonderful song!",
    "RUS": "Какая чудесная песня!",
    "POL": "Cóż za wspaniała pieśń!",
    "BEL": ""
  },
  {
    "KEY": "feast.7205.b",
    "FILE_PATH": "localization/belarusian/dlc/ce1/ce1_feast_l_belarusian.json",
    "ENG": "#EMP Oh!#! They even have [host.Custom('GetExpensiveDessert')] here!",
    "RUS": "#EMP Ого!#! Здесь есть даже [host.Custom('GetExpensiveDessert')]!",
    "POL": "#EMP Och, [host.Custom('GetExpensiveDessert')]!#! Ciekawe, co jeszcze tu mają!",
    "BEL": ""
  },
